      "text": faq.answer
    }
  }))
};
---

<Layout 
  title="FreeToolsHub - 60+ Free Online Web Tools | Fast, Secure & No Signup" 
  description="Discover 60+ lightning-fast, 100% free online tools for PDF editing, image compression, video trimming, QR code generation, calculators, and productivity."
>
  <Header />
  
  <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 flex-grow w-full">
    <!-- Hero Section -->
    <div class="text-center mb-12">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-accent/10 text-accent text-xs font-semibold mb-4 border border-accent/20">
        <span>⚡ 60+ 100% Free Web Tools</span>
      </div>
      <h1 class="text-4xl sm:text-5xl font-extrabold text-primary tracking-tight mb-4">
        Everything You Need in One Place
      </h1>
      <p class="text-lg sm:text-xl text-secondary max-w-2xl mx-auto">
        Lightning-fast, privacy-first web utilities to get things done. No registration, no watermarks, completely free forever.
      </p>
    </div>

    <!-- Category Filters Navigation -->
    <div class="mb-10">
      <div class="flex items-center justify-between mb-3">
        <h2 class="text-xs font-semibold uppercase tracking-wider text-secondary">Filter by Category</h2>
        <span id="active-count" class="text-xs font-medium text-secondary">Showing {tools.length} tools</span>
      </div>
      
      <div class="flex items-center gap-2 overflow-x-auto pb-2 scrollbar-none" id="category-filters" role="tablist" aria-label="Tool Categories">
        {categories.map((cat, idx) => (
          <button
            type="button"
            role="tab"
            aria-selected={idx === 0 ? "true" : "false"}
            data-category-id={cat.id}
            class={`category-tab inline-flex items-center gap-2 px-4 py-2 rounded-xl text-xs sm:text-sm font-semibold whitespace-nowrap transition-all duration-200 border cursor-pointer ${
              idx === 0
                ? 'bg-primary text-white border-primary shadow-sm'
                : 'bg-card text-secondary border-bordercolor hover:text-primary hover:border-accent/40 hover:bg-background'
            }`}
          >
            <span>{cat.icon}</span>
            <span>{cat.name}</span>
            <span class="text-[10px] px-1.5 py-0.5 rounded-full bg-black/10 dark:bg-white/10 opacity-80">
              {cat.id === 'all' ? tools.length : tools.filter(t => t.category === cat.id).length}
            </span>
          </button>
        ))}
      </div>
    </div>

    <!-- Tools Grid -->
    <div id="tools-grid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6">
      {tools.map((tool) => (
        <ToolCard 
          id={tool.id}
          title={tool.title}
          description={tool.description}
          url={tool.url}
          icon={tool.icon}
          category={tool.category}
          categoryName={tool.categoryName}
        />
      ))}
    </div>
    
    <!-- No Results State -->
    <div id="no-results" class="hidden text-center py-20">
      <div class="inline-flex items-center justify-center w-16 h-16 rounded-full bg-bordercolor/30 text-secondary mb-4">
        <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
        </svg>
      </div>
      <h2 class="text-2xl font-bold text-primary mb-2">No tools found</h2>
      <p class="text-base text-secondary max-w-md mx-auto mb-6">We couldn't find any tools matching your search criteria. Try a different term or clear filters.</p>
      <button 
        id="reset-filters-btn"
        type="button" 
        class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl bg-primary text-white text-sm font-semibold hover:bg-primary/90 transition-all shadow-sm"
      >
        <span>Reset Filters</span>
      </button>
    </div>

    <!-- FAQ Section -->
    <section class="mt-24 mb-8 border-t border-bordercolor pt-16">
      <div class="max-w-3xl mx-auto">
        <h2 class="text-3xl font-bold text-primary mb-10 text-center tracking-tight">Frequently Asked Questions</h2>
        <div class="space-y-6">
          {faqs.map((faq) => (
            <article class="bg-card border border-bordercolor rounded-xl p-6 shadow-sm hover:shadow-md hover:border-accent/30 transition-all duration-300">
              <h3 class="text-lg font-semibold text-primary mb-3">{faq.question}</h3>
              <p class="text-secondary leading-relaxed">{faq.answer}</p>
            </article>
          ))}
        </div>
      </div>
    </section>
  </main>
  
  <footer class="bg-card border-t border-bordercolor py-10 mt-auto">
    <div class="max-w-7xl mx-auto px-4 text-center flex flex-col items-center gap-4">
      <a
        href="https://ko-fi.com/kishara"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-amber-50 hover:bg-amber-100 border border-amber-200 text-amber-900 text-sm font-medium transition-all duration-200 shadow-sm hover:shadow"
        title="Support the Developer"
        aria-label="Support the Developer"
      >
        <span class="text-base leading-none">☕</span>
        <span>Support the Developer</span>
      </a>
      <p class="text-secondary text-sm font-medium">
        &copy; {new Date().getFullYear()} FreeToolsHub. All rights reserved.
      </p>
    </div>
  </footer>

  <!-- JSON-LD for SEO -->
  <script type="application/ld+json" set:html={JSON.stringify(schemaItemList)} />
  <script type="application/ld+json" set:html={JSON.stringify(schemaFaq)} />

  <!-- Client-side filtering & search -->
  <script>
    document.addEventListener('DOMContentLoaded', () => {
      const searchInput = document.getElementById('tool-search') as HTMLInputElement | null;
      const cards = document.querySelectorAll('.tool-card');
      const noResults = document.getElementById('no-results');
      const toolsGrid = document.getElementById('tools-grid');
      const categoryTabs = document.querySelectorAll('.category-tab');
      const activeCount = document.getElementById('active-count');
      const resetBtn = document.getElementById('reset-filters-btn');

      let currentCategory = 'all';
      let currentQuery = '';

      function filterTools() {
        let visibleCount = 0;

        cards.forEach((card) => {
          const el = card as HTMLElement;
          const title = el.getAttribute('data-title') || '';
          const desc = el.getAttribute('data-description') || '';
          const category = el.getAttribute('data-category') || '';

          const matchesCategory = currentCategory === 'all' || category === currentCategory;
          const matchesQuery = currentQuery === '' || title.includes(currentQuery) || desc.includes(currentQuery);

          if (matchesCategory && matchesQuery) {
            el.style.display = 'block';
            visibleCount++;
          } else {
            el.style.display = 'none';
          }
        });

        if (activeCount) {
          activeCount.textContent = `Showing ${visibleCount} tool${visibleCount === 1 ? '' : 's'}`;
        }

        if (toolsGrid && noResults) {
          if (visibleCount === 0) {
            toolsGrid.style.display = 'none';
            noResults.style.display = 'block';
          } else {
            toolsGrid.style.display = 'grid';
            noResults.style.display = 'none';
          }
        }
      }

      // Category tab click
      categoryTabs.forEach((tab) => {
        tab.addEventListener('click', () => {
          categoryTabs.forEach((t) => {
            t.classList.remove('bg-primary', 'text-white', 'border-primary', 'shadow-sm');
            t.classList.add('bg-card', 'text-secondary', 'border-bordercolor');
            t.setAttribute('aria-selected', 'false');
          });

          tab.classList.add('bg-primary', 'text-white', 'border-primary', 'shadow-sm');
          tab.classList.remove('bg-card', 'text-secondary', 'border-bordercolor');
          tab.setAttribute('aria-selected', 'true');

          currentCategory = tab.getAttribute('data-category-id') || 'all';
          filterTools();
        });
      });

      // Search input change
      if (searchInput) {
        searchInput.addEventListener('input', (e) => {
          currentQuery = (e.target as HTMLInputElement).value.toLowerCase().trim();
          filterTools();
        });
      }

      // Reset button click
      if (resetBtn) {
        resetBtn.addEventListener('click', () => {
          currentCategory = 'all';
          currentQuery = '';
          if (searchInput) {
            searchInput.value = '';
          }
          categoryTabs.forEach((t, idx) => {
            if (idx === 0) {
              t.classList.add('bg-primary', 'text-white', 'border-primary', 'shadow-sm');
              t.classList.remove('bg-card', 'text-secondary', 'border-bordercolor');
              t.setAttribute('aria-selected', 'true');
            } else {
              t.classList.remove('bg-primary', 'text-white', 'border-primary', 'shadow-sm');
              t.classList.add('bg-card', 'text-secondary', 'border-bordercolor');
              t.setAttribute('aria-selected', 'false');
            }
          });
          filterTools();
        });
      }
    });
  </script>
</Layout>
