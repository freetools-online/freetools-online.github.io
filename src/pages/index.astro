// Schema ItemList for SEO
const schemaItemList = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  "itemListElement": tools.map((tool, index) => ({
    "@type": "ListItem",
    "position": index + 1,
    "item": {
      "@type": "SoftwareApplication",
      "name": tool.title,
      "description": tool.description,
      "url": tool.url,
      "applicationCategory": "BrowserApplication",
      "offers": {
        "@type": "Offer",
        "price": "0.00",
        "priceCurrency": "USD"
      }
    }
  }))
};

const faqs = [
