---
---
<header class="bg-card border-b border-bordercolor py-4 sticky top-0 z-10 shadow-sm">
  <nav aria-label="Main Navigation" class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex flex-col md:flex-row justify-between items-center gap-4">
    <a href="/" class="text-2xl font-bold text-primary tracking-tight transition-colors hover:text-accent">FreeToolsHub</a>
    
    <div class="relative w-full md:w-96">
      <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
        <svg class="h-5 w-5 text-secondary" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
          <path fill-rule="evenodd" d="M8 4a4 4 0 100 8 4 4 0 000-8zM2 8a6 6 0 1110.89 3.476l4.817 4.817a1 1 0 01-1.414 1.414l-4.816-4.816A6 6 0 012 8z" clip-rule="evenodd" />
        </svg>
      </div>
      <input
        type="text"
        id="tool-search"
        aria-label="Search for tools"
        class="block w-full pl-10 pr-3 py-2.5 border border-bordercolor rounded-lg leading-5 bg-background text-primary placeholder-secondary focus:outline-none focus:ring-2 focus:ring-accent focus:border-accent sm:text-sm transition-all duration-200"
        placeholder="Search for tools (e.g. PDF, QR...)"
      />
    </div>
  </nav>
</header>
